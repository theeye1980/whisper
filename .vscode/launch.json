{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GPU Worker",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gpu_worker.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}